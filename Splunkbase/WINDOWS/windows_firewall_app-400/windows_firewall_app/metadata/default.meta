#
# Microsoft Windows Firewall Observability - default object permissions
#

[]
access = read : [ * ], write : [ admin, sc_admin, power ]
export = system

[eventtypes]
export = system

[props]
export = system

[transforms]
export = system

[lookups]
export = system

[macros]
export = system

[savedsearches]
access = read : [ * ], write : [ admin, sc_admin, power ]
export = none

[views]
access = read : [ * ], write : [ admin, sc_admin, power ]
export = none

[nav]
access = read : [ * ], write : [ admin, sc_admin, power ]
export = none

[viewstates]
access = read : [ * ], write : [ * ]
export = system

[datamodels]
access = read : [ * ], write : [ admin, sc_admin, power ]
export = system
